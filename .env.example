GITHUB_TOKEN=your_token_here

# Base URL for csc-export-tool's public credit-packages endpoint (GET /api/credits/packages).
# Defaults to https://eapi.countrystatecity.in when unset.
NEXT_PUBLIC_EXPORT_CREDITS_API_URL=https://eapi.countrystatecity.in

# Base URL for csc-app's public plans endpoint (GET /plans).
# Defaults to https://api.countrystatecity.in when unset.
NEXT_PUBLIC_APP_PLANS_API_URL=https://api.countrystatecity.in